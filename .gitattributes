# Line endings are pinned so a checkout reproduces what was committed.
#
# The committed blobs hold line feeds only, but git converts them on checkout
# wherever core.autocrlf is left at its Windows default. Pinning the
# working-tree ending here makes the checkout independent of whoever is
# checking out. Nothing is rewritten by this: the blobs are already line feed.

*.md        text eol=lf
*.cpp       text eol=lf
*.h         text eol=lf
*.yaml      text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
