{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Debug Build",
            "type": "shell",
            "group": "build",
            "command": "make",
            "args": [
                "-j",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "g++ -std=c++26 -Wall -Wextra -Wpedantic -O0 -g3 -> build/superluminal-debug"
        },
        {
            "label": "Release Build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "make",
            "args": [
                "-j",
                "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "g++ -std=c++26 -Wall -Wextra -Wpedantic -O2 -DNDEBUG -> build/superluminal"
        },
        {
            "label": "Run",
            "type": "shell",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "command": "./build/superluminal",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Release Build"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Release derlemesini yapar ve butun hesaplari ard arda calistirir"
        }
    ]
}
