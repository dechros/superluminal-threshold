# Patterns here are anchored with a leading slash wherever they name a
# directory, because an unanchored name matches at EVERY depth. That is not a
# style preference. The bare pattern `core`, meant for core dumps, also matched
# the directory `src/core`, so Section.h and Report.h were never committed:
# every translation unit in the project includes one of them, and a fresh clone
# of this repository did not build. Nothing warned, because an ignored file does
# not appear in `git status`. Prefer `/name` over `name`, and when a rule could
# plausibly collide with a source directory, add an explicit negation next to it.

# ---- Build output ----------------------------------------------------------
/build/
/bin/
/obj/
/out/
/superluminal
/superluminal-debug
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.elf
*.gch
*.pch

# ---- Compiler and tooling output -------------------------------------------
compile_commands.json
/.cache/
*.gcno
*.gcda
*.gcov
callgrind.out.*
perf.data*
massif.out.*
vgcore.*
# Core dumps, at the repository root only. `src/core` is source and is kept.
/core
/core.*
!src/core/

# ---- Sanitizer and profiling output ----------------------------------------
*.profraw
*.profdata
*.log

# ---- Editors and IDEs ------------------------------------------------------
# The task, launch and IntelliSense settings under .vscode ARE part of this
# repository; only personal or transient files are excluded.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
!.vscode/settings.json
!.vscode/extensions.json
/.idea/
*.swp
*.swo
*~
*.orig
*.rej
/.clangd/
/.claude/

# ---- Operating system ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Python ----------------------------------------------------------------
# No Python remains in this repository. The rules stay so that a stray cache
# directory from an older checkout never appears as an untracked file.
__pycache__/
*.pyc
/.venv/
/venv/
